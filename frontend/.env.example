# Agriculture admin frontend

# Main Agriculture.Api
# VITE_API_URL=http://localhost:5109

# Tarım AI (sibling service). Leave unset to use Vite proxy path `/tarim-ai-api`
# (not `/tarim-ai` — that path is the admin UI route).
# Direct URL (needs CORS on tarim_ai if not proxied):
# VITE_TARIM_AI_URL=http://localhost:4000

# Vite proxy target for `/tarim-ai-api` rewrite (dev + preview):
# VITE_TARIM_AI_PROXY_TARGET=http://localhost:4000

# Optional: MinIO/CDN base for demo drone stills (no trailing slash)
# VITE_DRONE_PHOTOS_BASE=http://127.0.0.1:9000/tarim-uploads/drone_photos
