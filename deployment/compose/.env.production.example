# Copy to .env.production on the production host. Never commit the real file.
PRODUCTION_HOST=tarim.example.gov.tr
FRONTEND_PORT=8080

# Every image must use an immutable sha256 digest; mutable tags and latest are rejected by preflight.
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU22-ubuntu-22.04@sha256:CHANGE_ME
POSTGRES_IMAGE=pgvector/pgvector:pg16@sha256:CHANGE_ME
MINIO_IMAGE=minio/minio:RELEASE.CHANGE_ME@sha256:CHANGE_ME
MINIO_MC_IMAGE=minio/mc:RELEASE.CHANGE_ME@sha256:CHANGE_ME
REDIS_IMAGE=redis:7-alpine@sha256:CHANGE_ME
SEQ_IMAGE=datalust/seq:CHANGE_ME@sha256:CHANGE_ME
API_MIGRATION_IMAGE=registry.example.gov.tr/agriculture-api-migration:1.0.0@sha256:CHANGE_ME
API_IMAGE=registry.example.gov.tr/agriculture-api:1.0.0@sha256:CHANGE_ME
TARIM_AI_MIGRATION_IMAGE=registry.example.gov.tr/agriculture-tarim-ai-migration:1.0.0@sha256:CHANGE_ME
TARIM_AI_IMAGE=registry.example.gov.tr/agriculture-tarim-ai:1.0.0@sha256:CHANGE_ME
FRONTEND_IMAGE=registry.example.gov.tr/agriculture-frontend:1.0.0@sha256:CHANGE_ME

MSSQL_SA_PASSWORD=CHANGE_ME_RANDOM_32_CHARS_MINIMUM
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_CHARS_MINIMUM
MINIO_ROOT_USER=CHANGE_ME_UNIQUE_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_32_CHARS_MINIMUM
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_MINIMUM
TARIM_AI_INTEGRATION_KEY=CHANGE_ME_RANDOM_64_CHARS_MINIMUM
SEQ_ADMIN_PASSWORD=CHANGE_ME_RANDOM_32_CHARS_MINIMUM
WEB_PUSH_SUBJECT=mailto:admin@example.gov.tr
WEB_PUSH_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
WEB_PUSH_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# Enable only for the first successful start, then set false and erase the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.tr
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_RANDOM_14_CHARS_MINIMUM
BOOTSTRAP_ADMIN_FIRST_NAME=Sistem
BOOTSTRAP_ADMIN_LAST_NAME=Yöneticisi
