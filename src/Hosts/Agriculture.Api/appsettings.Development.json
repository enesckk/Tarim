{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=AgricultureDb.sqlite"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true,
    "SeedVerifiedParcelData": true
  },
  "Minio": {
    "Enabled": false,
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin"
  },
  "Jwt": {
    "Issuer": "Agriculture",
    "Audience": "Agriculture",
    "Secret": "AgricultureDevSecretKey_ChangeInProduction_Min32Chars!",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "TarimAi": {
    "IntegrationApiKey": "dev-tarim-ai-integration-key"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5174",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
