# Local / Docker defaults — copy to `.env` (gitignored).
# Production: set real secrets via environment or KeyVault; never commit them.

MSSQL_SA_PASSWORD=Your_strong_Password123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API (non-Development) — required:
# ConnectionStrings__DefaultConnection=Server=...;Database=AgricultureDb;User Id=...;Password=...;TrustServerCertificate=True
# Jwt__Secret=use-a-long-random-secret-at-least-32-chars
# ASPNETCORE_ENVIRONMENT=Production
# Optional one-shot migrator job:
# Database__ApplyMigrationsOnStartup=true
