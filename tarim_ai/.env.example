COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_BASE_URL=https://sh.dataspace.copernicus.eu
PORT=4000

# Parcel resolution: mock (local) | tkgm (live CBS)
PARCEL_PROVIDER=mock
TKGM_BASE_URL=https://cbsapi.tkgm.gov.tr/megsiswebapi.v3.1/api
TKGM_TIMEOUT_MS=10000
TKGM_MAX_RETRIES=2
TKGM_PROVINCES_PATH=/idariYapi/ilListe
TKGM_DISTRICTS_PATH=/idariYapi/ilceListe/{provinceId}
TKGM_NEIGHBORHOODS_PATH=/idariYapi/mahalleListe/{districtId}
TKGM_PARCEL_PATH=/parsel/{neighborhoodId}/{block}/{parcel}
TKGM_REFERER=https://parselsorgu.tkgm.gov.tr/

# Climate: mock | nasa-power | fallback | external
CLIMATE_PROVIDER=mock
NASA_POWER_BASE_URL=https://power.larc.nasa.gov
NASA_POWER_TIMEOUT_MS=30000
NASA_POWER_MAX_RETRIES=2
NASA_POWER_HISTORY_YEARS=10
NASA_POWER_CONCURRENCY=2
EXTERNAL_CLIMATE_BASE_URL=
EXTERNAL_CLIMATE_TIMEOUT_MS=10000

# Soil: mock | soilgrids | fallback | external
SOIL_PROVIDER=mock
SOILGRIDS_BASE_URL=https://rest.isric.org
SOILGRIDS_TIMEOUT_MS=30000
SOILGRIDS_MAX_RETRIES=1
SOILGRIDS_CACHE_TTL_DAYS=30
EXTERNAL_SOIL_BASE_URL=
EXTERNAL_SOIL_TIMEOUT_MS=10000

# Terrain: mock | copernicus-dem | fallback
TERRAIN_PROVIDER=mock
# Set true only when CDSE Process API DEM (COPERNICUS_30) is enabled for the account
TERRAIN_DEM_ENABLED=false
TERRAIN_DEM_INSTANCE=COPERNICUS_30
TERRAIN_DEM_TIMEOUT_MS=60000

# Land usability decision engine (additive crop response enrichment)
LAND_USABILITY_ENABLED=true

# Crop physical compatibility (additive; does not change scores/ranks)
CROP_PHYSICAL_COMPATIBILITY_ENABLED=true

# Calibration & expert validation management (in-memory; does not change scores/ranks)
CALIBRATION_MANAGEMENT_ENABLED=true

# Persistence: in-memory (default) | postgresql
DATABASE_ENABLED=false
PERSISTENCE_PROVIDER=in-memory
DATABASE_URL=postgresql://tarim:tarim@localhost:5433/tarim_ai
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_AUTO_MIGRATE=false

# Weekly auto land analysis (requires AMS integration endpoint)
WEEKLY_ANALYSIS_ENABLED=false
WEEKLY_ANALYSIS_INTERVAL_DAYS=7
WEEKLY_ANALYSIS_CHECK_MINUTES=60
AMS_BASE_URL=http://127.0.0.1:5109
AMS_INTEGRATION_API_KEY=
# Production: use the same random 64+ character value in the API's
# TarimAi__IntegrationApiKey setting. It authenticates both service directions.
