{
  "expo": {
    "name": "Tarım Üretici",
    "slug": "agriculture-producer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E3B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "local.agriculture.producer",
      "infoPlist": {
        "NSCameraUsageDescription": "Görev kanıtı için fotoğraf çekmek üzere kamera kullanılır.",
        "NSPhotoLibraryUsageDescription": "Görev kanıtı için galeriden fotoğraf seçilir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "local.agriculture.producer",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:5109"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Görev kanıtı için galeriden fotoğraf seçilir.",
          "cameraPermission": "Görev kanıtı için fotoğraf çekmek üzere kamera kullanılır."
        }
      ]
    ]
  }
}
